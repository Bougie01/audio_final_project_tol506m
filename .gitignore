# ESC-50 and other downloaded data are never committed (see README for download steps)...
data/*
# ...but our own recordings are part of the hand-in
!data/user_samples/
!data/my_recordings/
cache/
__pycache__/
*.pyc
.venv/
# saved models: only the checkpoint the demo uses is committed; the others are reproducible
models/*.pt
!models/cnn_specaug_mixup_s1.pt
# training-clip audio may be third-party (e.g. Mixkit) and is not redistributed;
# the Sound Lab only needs the embeddings in data/user_samples/samples.csv
data/user_samples/*.wav
